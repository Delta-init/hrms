# ─── Server ───────────────────────────────────────────────
PORT=5055
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/hrms

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=change-me-access-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── Seed Super Admin ─────────────────────────────────────
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@hrms.com
SUPER_ADMIN_PASSWORD=Admin@12345

# ── Email (optional) — birthday alerts to HR. If unset, emails are logged only. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Delta HRMS <no-reply@yourcompany.com>"
# Daily birthday check (server local time). Default 08:00.
BIRTHDAY_CRON=0 8 * * *

# ── Cloudflare R2 (S3-compatible) — employee documents & photos. ──
# When unset, document upload is disabled (routes return a clear 503).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hrms-documents
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
