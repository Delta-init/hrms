# ─── Server ───────────────────────────────────────────────
PORT=5055
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/hrms

# ─── JWT ──────────────────────────────────────────────────
# Each must be at least 32 chars and independently random — generate with
# `openssl rand -base64 32`. These are HMAC keys: a guessable one lets anyone
# mint valid tokens.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
# Optional. Signs impersonation tickets; derived from JWT_SECRET when unset.
JWT_TICKET_SECRET=

# ─── Seed Super Admin ─────────────────────────────────────
SUPER_ADMIN_NAME=Super Admin
# Required — the app refuses to boot without these. Use a real address and a
# generated password; the seeded account must set its own password via
# /set-password before it can sign in.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Email (optional) — birthday alerts to HR. If unset, emails are logged only. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Delta HRMS <no-reply@yourcompany.com>"
# Daily birthday check (server local time). Default 08:00.
BIRTHDAY_CRON=0 8 * * *

# ── Cloudflare R2 (S3-compatible) — employee documents & photos. ──
# When unset, document upload is disabled (routes return a clear 503).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hrms-documents
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ── Face recognition (hrms-face-ditector) — kiosk attendance. ──
# When unset, face enrollment and face check-in are disabled and their routes
# return a clear 503. The service must be reachable on loopback only.
FACE_SERVICE_URL=http://127.0.0.1:8000
# Must match FACE_SERVICE_KEY in hrms-face-ditector/.env
FACE_SERVICE_KEY=
# Recognition is CPU inference, so allow seconds rather than milliseconds.
FACE_SERVICE_TIMEOUT_MS=15000
# Captures taken per employee at enrollment, from slightly different angles.
FACE_ENROLL_MIN_CAPTURES=3
FACE_ENROLL_MAX_CAPTURES=5
# Ignore a repeat recognition of the same person within this window, so
# lingering in front of the kiosk camera doesn't undo the punch just made.
FACE_PUNCH_COOLDOWN_SECONDS=60
# How long the frame a punch was made from is kept, for settling disputes.
FACE_PROOF_RETENTION_DAYS=30
FACE_PROOF_PURGE_CRON=30 3 * * *
# Liveness. "required" makes every kiosk punch prove somebody is really there
# by following head-turn prompts, which costs about three seconds and defeats a
# photograph. "off" punches from a single frame in under a second — and a
# printed photo or a phone screen will then clock that person in, so only use it
# where somebody can see the device.
FACE_LIVENESS_MODE=required
FACE_LIVENESS_TTL_SECONDS=30
# How far below the match threshold still counts as "too alike to enrol".
# Two faces this close cannot be told apart at the kiosk, so enrolling the
# second would stop both of them checking in.
FACE_DUPLICATE_MARGIN=0.1
