# Express backend base URL (server-side, used by NextAuth authorize)
API_URL=http://localhost:5055/api/v1
# Public base URL used by the browser axios client
NEXT_PUBLIC_API_URL=http://localhost:5055/api/v1
# NextAuth
NEXTAUTH_URL=http://localhost:4030
NEXTAUTH_SECRET=generate-a-random-secret-here

# The one origin allowed to put this application in an iframe.
#
# The Root portal opens each system it fronts inside a frame, and this
# application refuses by default — it tells every browser that nobody may frame
# it. Naming the portal here narrows that to one origin rather than removing it.
#
# Unset means unframeable, which is the safe default and what every deployment
# did before. A value that is not a URL is treated as unset rather than trusted.
#
# Read at build time, so it must be set before the build, not only at runtime.
PORTAL_WEB_ORIGIN=
