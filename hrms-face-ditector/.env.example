# Copy to .env on the VPS and fill in. Never commit .env.

# --- Network -----------------------------------------------------------------
# Bind to loopback only. The Node backend is the sole caller; nothing about this
# service should be reachable from the internet.
FACE_HOST=127.0.0.1
FACE_PORT=8000

# --- Auth --------------------------------------------------------------------
# Shared secret sent by the Node backend as the X-Face-Service-Key header.
# Generate with: openssl rand -hex 32
FACE_SERVICE_KEY=

# --- Models ------------------------------------------------------------------
FACE_MODEL_PACK=buffalo_l
# Models are downloaded to <root>/models/<pack>, i.e. ./models/buffalo_l here.
FACE_MODEL_ROOT=.
# Detector input size. 640 is the accuracy/speed sweet spot on CPU.
FACE_DET_SIZE=640
# Detector confidence floor. Anything below this is not reported as a face.
FACE_DET_THRESH=0.5
# ONNX Runtime thread count. Leave at 0 to let ORT decide; set to 2-4 on a small
# VPS so face inference can't starve the Node API sharing the box.
FACE_ORT_THREADS=0

# --- Matching (CALIBRATE THESE — see README "Calibration") -------------------
# Cosine similarity a match must reach, and how far it must beat the runner-up.
# These starting values are placeholders, not validated settings.
FACE_MATCH_THRESHOLD=0.45
FACE_MATCH_MARGIN=0.05

# --- Enrollment quality gates ------------------------------------------------
FACE_ENROLL_MIN_FACE_PIXELS=110
FACE_ENROLL_MIN_DET_SCORE=0.65
FACE_ENROLL_MIN_BLUR=45
FACE_ENROLL_MIN_BRIGHTNESS=60
FACE_ENROLL_MAX_BRIGHTNESS=215
FACE_ENROLL_MAX_YAW=25
FACE_ENROLL_MAX_PITCH=25

# --- Recognition quality gates (deliberately looser than enrollment) ---------
FACE_RECOGNIZE_MIN_FACE_PIXELS=80
FACE_RECOGNIZE_MIN_DET_SCORE=0.5
# A second face this close in size to the largest makes the frame ambiguous —
# we refuse rather than guess who is punching in.
FACE_RECOGNIZE_AMBIGUOUS_FACE_RATIO=0.7

# --- Limits ------------------------------------------------------------------
FACE_MAX_IMAGE_BYTES=8388608
FACE_MAX_IMAGE_DIM=1600
# Must cover a whole liveness challenge: one frame per prompt, plus a spare.
FACE_MAX_FRAMES=8
FACE_MAX_GALLERY_VECTORS=50000

FACE_LOG_LEVEL=INFO

# --- Liveness ----------------------------------------------------------------
# Tolerances for the pose challenge. "center" is what a person looking at the
# kiosk holds; the turn threshold is how far they must actually turn.
FACE_LIVENESS_CENTER_MAX_YAW=14
FACE_LIVENESS_CENTER_MAX_PITCH=22
FACE_LIVENESS_TURN_MIN_YAW=16
# All frames of one challenge must be the same person. Looser than the match
# threshold — it is one face seconds apart, but at different angles.
FACE_LIVENESS_SAME_PERSON_MIN=0.35
# Mean pixel difference below which two frames are treated as the same picture.
FACE_LIVENESS_MIN_FRAME_DIFFERENCE=2.0

# --- Presentation-attack models (no weights are committed) --------------------
# Directory of ONNX models produced by scripts/fetch_antispoof.py. Unset means
# no spoof scoring at all, and with the pose challenge also off that leaves
# nothing between a photograph and an attendance record.
#
# Scored on every punch, whether or not the pose prompts are on — it is the
# defence that lets a kiosk stay fast and still refuse a photo.
FACE_ANTISPOOF_DIR=
# Refuse at or above this spoof probability. This default is a starting point,
# NOT a measured value: scores move with your camera, your lighting, and the
# attack. Measure yours before trusting it:
#   uv run python scripts/calibrate_antispoof.py --live dataset/live --spoof dataset/spoof
FACE_ANTISPOOF_THRESHOLD=0.5
# Which output class means "live". 1 for the published MiniFASNet models.
FACE_ANTISPOOF_LIVE_INDEX=1
